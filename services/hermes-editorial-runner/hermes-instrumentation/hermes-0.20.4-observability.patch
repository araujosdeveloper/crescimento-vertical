+def _sanitize_turn_exit_reason(turn_exit_reason):
+    """Enumera e sanitiza a decisão interna do loop (nunca finish_reason do SDK)."""
+    if not isinstance(turn_exit_reason, str) or not turn_exit_reason.strip():
+        return None
+    prefix = turn_exit_reason.strip().split("(", 1)[0].strip()
+    return prefix if prefix in _TURN_EXIT_REASON_CATEGORIES else "unknown"
+

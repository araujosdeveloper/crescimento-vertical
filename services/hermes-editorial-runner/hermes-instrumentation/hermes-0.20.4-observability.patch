+++ b/hermes_cli/oneshot.py
@@ -127,6 +127,22 @@
-def _write_usage_file(path: Optional[str], result: dict, failure: Optional[str] = None) -> None:
+import re
+
+_TURN_EXIT_FINISH_RE = re.compile(r"finish_reason=([a-z_]+)")
+_VALID_FINISH_REASONS = frozenset({"stop", "length", "content_filter", "tool_calls"})
+
+
+def _extract_finish_reason(turn_exit_reason) -> Optional[str]:
+    """Recupera o finish_reason real embutido em ``turn_exit_reason``."""
+    if not isinstance(turn_exit_reason, str):
+        return None
+    match = _TURN_EXIT_FINISH_RE.search(turn_exit_reason)
+    if not match:
+        return None
+    value = match.group(1)
+    return value if value in _VALID_FINISH_REASONS else None
+
+
+def _write_usage_file(path: Optional[str], result: dict, failure: Optional[str] = None) -> None:
@@ -155,6 +171,14 @@
         report = {
@@ -161,6 +177,12 @@
             "failed": bool(result.get("failed")) or failure is not None,
             "service_tier": result.get("service_tier"),
+            # Contrato de observabilidade v1 (ADR-034): finish_reason real e
+            # contadores Tavily. Nunca prompts/respostas/headers/cookies/segredos.
+            "finish_reason": _extract_finish_reason(result.get("turn_exit_reason")),
         }
+        try:
+            from plugins.web.tavily.provider import get_operation_counts
+

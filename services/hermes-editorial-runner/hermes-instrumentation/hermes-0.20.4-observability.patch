 logger = logging.getLogger(__name__)
 
+_OPERATION_COUNTS = {
+    "search": {"attempted": 0, "succeeded": 0, "failed": 0},
+    "extract": {"attempted": 0, "succeeded": 0, "failed": 0},
+}
+
+
+def _record_attempt(endpoint: str) -> None:
+    if endpoint in _OPERATION_COUNTS:
+        _OPERATION_COUNTS[endpoint]["attempted"] += 1
+
+
+def _record_result(endpoint: str, ok: bool) -> None:
+    if endpoint in _OPERATION_COUNTS:
+        _OPERATION_COUNTS[endpoint]["succeeded" if ok else "failed"] += 1
+
+
+def get_operation_counts() -> Dict[str, Dict[str, int]]:
+    """Devolve contadores exatos ``{search/extract: {attempted, succeeded, failed}}``."""
+    return {op: dict(_OPERATION_COUNTS[op]) for op in _OPERATION_COUNTS}
+
 

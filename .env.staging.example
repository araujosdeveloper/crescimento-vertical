# Staging exclusivo — nunca subir para produção nem versionar segredos reais.
STAGING_HOST=staging.crescimentovertical.com
SITE_NOINDEX=true
NEXT_PUBLIC_SITE_URL=https://staging.crescimentovertical.com
NEXT_PUBLIC_CONTACT_EMAIL=contato@crescimentovertical.com

# WhatsApp opcional no staging — vazio mantém o fallback por e-mail.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# Basic Auth do Traefik. Gere o hash com: openssl passwd -apr1
# Formato: usuario:hash, com "$" duplicado ($$) para o Compose preservar o hash.
# Nunca cole senha ou hash real neste arquivo de exemplo.
STAGING_BASIC_AUTH_USERS=usuario:$$apr1$$EXEMPLO$$placeholder

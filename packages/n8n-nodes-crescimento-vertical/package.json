{
  "name": "n8n-nodes-crescimento-vertical",
  "version": "1.0.0",
  "description": "n8n node for the Crescimento Vertical Hermes editorial runner (connectivity/validation only)",
  "keywords": [
    "n8n-community-node-package",
    "crescimento-vertical",
    "hermes"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/HermesEditorial/HermesEditorial.node.js"
    ],
    "credentials": [
      "dist/credentials/CrescimentoVerticalHermesApi.credentials.js"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}

# Variáveis NEXT_PUBLIC são incorporadas ao frontend. Nunca coloque segredos aqui.
NEXT_PUBLIC_SITE_URL=https://crescimentovertical.com
NEXT_PUBLIC_CONTACT_EMAIL=contato@crescimentovertical.com

# Somente dígitos, incluindo país e DDD. Exemplo de formato: 55DDDNUMERO.
# Enquanto estiver vazio, os CTAs usam o e-mail e nenhum número fictício aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Vim pelo site da Crescimento Vertical e quero entender como estruturar melhor o crescimento digital da minha empresa.

# ---------------------------------------------------------------------------
# Payload CMS + PostgreSQL (Fase 2A). Somente nomes de variáveis e exemplos
# inofensivos — nunca gere valores reais aqui nem os versione.
# ---------------------------------------------------------------------------

# String de conexão da aplicação com o PostgreSQL (somente rede interna).
DATABASE_URL=postgresql://cms_user:CHANGE_ME@postgres:5432/crescimento_vertical

# Segredo do Payload (cookies/autenticação). Use pelo menos 32 caracteres.
PAYLOAD_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# Credenciais usadas pelo serviço de banco (apenas para o Compose provisionar).
POSTGRES_DB=crescimento_vertical
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Diretório opcional de mídia persistente. Default: ./media (volume no Compose).
# PAYLOAD_MEDIA_DIR=
